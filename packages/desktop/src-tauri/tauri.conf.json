{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LensFrame",
  "version": "1.0.0",
  "identifier": "com.lensframe.app",
  "build": {
    "beforeDevCommand": "npm --workspace=@exif-frame/web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --workspace=@exif-frame/web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "렌즈프레임 (LensFrame)",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
